{
    "version": 2,
    "builds": [{
        "src": "server.ts",
        "use": "@now/node"
    }],
    "headers": [{
        "source": "/(.*)",
        "headers": [{
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }]
    }],
    "rewrites": [{
        "source": "/(.*)",
        "destination": "/server.ts"
    }]
}